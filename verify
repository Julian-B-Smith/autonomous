#!/usr/bin/env bash
# verify — oracle dispatcher for the autonomous repo itself.
# Usage: ./verify fast | full | report
# Contract: exit 0 = green, nonzero = red. Writes .harness/last-verify.json.
set -uo pipefail
cd "$(dirname "$0")"

TARGET="${1:-fast}"
HARNESS_DIR=".harness"
mkdir -p "$HARNESS_DIR"

# Kit-owned gates: record, leak_gate, kit_integrity. A repo missing this file
# is not a lesser repo, it is an UNGATED one, so failing loudly beats degrading
# quietly — a silently skipped privacy gate is exactly the shape of bug the
# gate exists to prevent.
if [ -r .kit/kit-gates.sh ]; then
  . .kit/kit-gates.sh
else
  echo "verify: .kit/kit-gates.sh missing — run kit_sync.py (gates cannot be skipped)" >&2
  exit 1
fi

fast() {
  # ---- Layer-0: seconds. CI-blocking. --------------------------------------
  local ok=0
  # 0. Privacy: no machine-absolute paths committed
  kit_integrity || ok=1   # kit-owned files match .kit/MANIFEST
  leak_gate || ok=1
  # 1. Sweep primitive + governor monitor unit tests
  (cd kit/sweep && python3 -m unittest discover -q .) \
    || { echo "verify[fast]: sweep tests red" >&2; ok=1; }
  (cd governor && python3 -m unittest discover -q .) \
    || { echo "verify[fast]: governor tests red" >&2; ok=1; }
  # kit/gates ships checks that OTHER repos wire into their own verify. If its
  # tests are not discovered here, a broken kit gate propagates outward silently
  # — the shipped-untested case is worse than the untested-local one.
  (cd kit/gates && python3 -m unittest discover -q .) \
    || { echo "verify[fast]: kit gate tests red" >&2; ok=1; }
  # kit/currency.py drives every /retrofit in the fleet; its REQUIREMENTS
  # table must stay in lockstep with CHANGELOG.md (a test pins that).
  # test_kit_sync is named as 2.4.0's gate in the CHANGELOG; it must therefore
  # actually RUN here. It did not, for three commits — and thinning
  # harness/verify quietly broke three of its cases while this stayed green.
  # A gate a CHANGELOG claims but no oracle invokes is a claim, not a gate.
  (cd kit && python3 -m unittest -q test_currency test_kit_sync) \
    && (cd kit/session && python3 -m unittest -q test_session test_batch_close) \
    && (cd kit/hooks && python3 -m unittest -q test_oversight_hooks) \
    && (cd governor && python3 -m unittest -q test_retrofit_verify) \
    || { echo "verify[fast]: kit currency tests red" >&2; ok=1; }
  # Retired doctrine phrases must not survive in INSTALLING artifacts
  # (hypersaw-002): a rule corrected where it is READ but left in the charter
  # and CHANGELOG action that COPY it is correct where nobody looks and wrong
  # where everybody inherits it. Records (integrations/, DECISIONS, research)
  # may quote retired text; kit/, doctrine/, CLAUDE.md, ONBOARDING may not.
  # Add a phrase here whenever a ruling retires one; the string is the gate.
  local retired hits
  retired='not a to-do, not a warning, not context|between other repos are ignored'
  hits=$(git grep --untracked -nIE "$retired" -- . ':(exclude)integrations/*' ':(exclude)DECISIONS.md' ':(exclude)research/*' ':(exclude)briefs/*' ':(exclude)verify' 2>/dev/null || true)
  if [ -n "$hits" ]; then
    echo "verify: RETIRED PHRASE — a rule the doctrine corrected still appears in an installing artifact:" >&2
    echo "$hits" | sed 's/^/    /' >&2; ok=1
  fi
  # No INSTALLING artifact may ship copyable gate code (Decision 65). The kit
  # can fix a rule where it is READ and leave it wrong where it is INHERITED —
  # that is hypersaw-002's lesson, and 2.4.0 reproduced it: the doctrine moved
  # to vendoring while harness/verify still carried an inline leak_gate, so
  # every fresh retrofit would have manufactured the drift 2.4.0 exists to end.
  # Canonical gate code lives in ONE place, kit/vendor/, and is vendored from
  # there. A definition anywhere a repo copies from is the bug.
  local gatedefs
  gatedefs=$(git grep --untracked -nE '^(leak_gate|record)\(\) \{' -- harness/ kit/templates/ 2>/dev/null || true)
  if [ -n "$gatedefs" ]; then
    echo "verify: COPYABLE GATE — an installing artifact defines gate code; it belongs in kit/vendor/:" >&2
    echo "$gatedefs" | sed 's/^/    /' >&2; ok=1
  fi
  # cites: affirmed at intake (INTEGRATIONS, ratified 2026-09-02). Reported,
  # not blocking, for now: every pre-ratification thread lacks the key, and a
  # gate that reds the whole mailbox on day one gets bypassed rather than
  # honoured. Flip to `ok=1` once the backlog is affirmed (tracked in ROADMAP).
  python3 - <<'PYEOF3' || true
import sys, os
sys.path.insert(0, "governor")
import ball_scan
for b in ball_scan.cites_missing("."):
    print(f"verify: CITES MISSING — {b['file']} is {b['status']} with no cites: "
          f"(resident affirms at intake)", file=sys.stderr)
PYEOF3
  # Exchange frontmatter must not lie about its own state (Decision 57).
  python3 - <<'PYEOF2' || ok=1
import sys, os
sys.path.insert(0, "governor")
import ball_scan
bad = ball_scan.frontmatter_lies(".")
for b in bad:
    print(f"verify: STALE FRONTMATTER — {b['file']} still says ball={b['says']} "
          f"but the thread has an answer", file=sys.stderr)
sys.exit(1 if bad else 0)
PYEOF2
  # And the standards repo must pass its own checker — a false declaration
  # here is the one place it would be indefensible.
  python3 kit/currency.py . --json | python3 -c 'import json,sys; r=json.load(sys.stdin); sys.exit(0 if r["current"] and not r.get("declared_but_missing") else 1)' \
    || { echo "verify[fast]: autonomous is not current against its own kit (run kit/currency.py .)" >&2; ok=1; }
  # 2. Machine-readable artifacts parse
  python3 - <<'EOF' || ok=1
import json, sys
for p in ("registry.json",):
    try:
        json.load(open(p))
    except Exception as e:
        print(f"verify[fast]: {p} invalid: {e}", file=sys.stderr); sys.exit(1)
EOF
  # 3. Structure: canonical files present
  for f in README.md DESIGN.md ROADMAP.md DECISIONS.md ONBOARDING.md \
           doctrine/DOCTRINE.md doctrine/INTEGRATIONS.md; do
    [ -f "$f" ] || { echo "verify[fast]: missing $f" >&2; ok=1; }
  done
  # 4. Context budget (Decision 28): DOCTRINE.md auto-loads into EVERY session
  # on every machine, so its size is a tax on all work. Budget: 9000 chars
  # (~2.2k tokens). Over budget => merge or DELETE a tenet — the landscape
  # audit's required DELETIONS section exists precisely for this. Adding
  # without subtracting is how doctrine becomes noise.
  local dsize; dsize=$(wc -c < doctrine/DOCTRINE.md | tr -d ' ')
  if [ "$dsize" -gt 9000 ]; then
    echo "verify[fast]: DOCTRINE.md ${dsize} chars > 9000 budget — merge or delete a tenet" >&2
    ok=1
  fi
  return $ok
}

full() {
  fast || return $?
  # ---- Layer-E additions ----------------------------------------------------
  # Sweep smoke against the real registry: must resolve >0 projects.
  local n
  n=$(python3 kit/sweep/sweep.py --registry registry.json list | python3 -c "import json,sys;print(len(json.load(sys.stdin)))") \
    || { echo "verify[full]: sweep smoke failed" >&2; return 1; }
  [ "$n" -gt 0 ] || { echo "verify[full]: registry resolved 0 projects" >&2; return 1; }
  echo "verify[full]: registry resolves $n projects"
  return 0
}

case "$TARGET" in
  fast)   fast;  record fast  $? ;;
  full)   full;  record full  $? ;;
  report) cat "$HARNESS_DIR/last-verify.json" 2>/dev/null || { echo '{"target":null,"exit":null}'; exit 1; } ;;
  *)      echo "usage: ./verify fast|full|report" >&2; exit 64 ;;
esac
